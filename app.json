{
  "expo": {
    "name": "RSSA",
    "slug": "dating-match-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/love.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/love.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.datingapp.match",
      "buildNumber": "3",
      "icon": "./assets/love.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show you potential matches nearby.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to let you upload profile pictures and create posts.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "icon": "./assets/love.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/love.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.datingapp.match",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/love.png"
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DatingMatchApp to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "66de7501-0334-4ba3-a489-93930d6caa36"
      }
    },
    "owner": "tonyleungdkkf"
  }
}
